# Runtime
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8010
LOG_LEVEL=INFO
# Use "json" in production and "console" for readable local logs.
LOG_FORMAT=console
# Browser origins only; native mobile clients are not subject to CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production must use explicit public/internal hostnames instead of *.
TRUSTED_HOSTS=*
FORWARDED_ALLOW_IPS=127.0.0.1
MAX_UPLOAD_MB=1000
STUDY_BUDDY_MENUBAR=true
STUDY_BUDDY_TELEGRAM=true

# LM Studio (OpenAI-compatible local server)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=qwen3.5-4b-mlx
VISION_MODEL=qwen/qwen3-vl-4b

# Models (all local, lightweight)
STT_MODEL=moonshine/base
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
KOKORO_VOICE=af_heart

# Paths (relative to backend/ by default)
DATA_DIR=data
INBOX_DIR=inbox

# Google Calendar (OAuth 2.0; use a local .env and never commit the secret)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8010/api/calendar/google/callback
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata

# Telegram bot (create/rotate with @BotFather; never commit the token)
TELEGRAM_BOT_TOKEN=
# Send /id to the bot, then add your numeric Telegram user ID here.
TELEGRAM_ALLOWED_USER_IDS=
# Optional: additionally restrict allowed chat IDs (comma-separated).
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOW_ALL=false
TELEGRAM_MAX_UPLOAD_MB=20
